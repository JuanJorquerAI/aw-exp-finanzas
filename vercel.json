{
  "version": 2,
  "buildCommand": "pnpm run build:api",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "node_modules/.prisma/**,node_modules/.pnpm/@prisma+client*/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
